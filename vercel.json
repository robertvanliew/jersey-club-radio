{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "jersey-club-radio.vercel.app" }],
      "destination": "https://jerseyclubradio.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/artists/:slug", "destination": "/" }]
}
